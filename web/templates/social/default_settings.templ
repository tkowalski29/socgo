package social

templ DefaultProviderSettings(providerName string) {
  <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-4">
    <h3 class="text-lg font-medium text-gray-900 mb-3">Settings for {providerName}</h3>
    <p class="text-gray-600">No specific settings available for this provider.</p>
  </div>
} 