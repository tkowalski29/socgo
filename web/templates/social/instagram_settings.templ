package social

templ InstagramSettings(providerName string) {
  <div class="bg-pink-50 border border-pink-200 rounded-lg p-4 mb-4">
    <h3 class="text-lg font-medium text-pink-900 mb-3">Instagram Settings for {providerName}</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-pink-800 mb-2">Post Type</label>
        <select name={"instagram_post_type_" + providerName} class="w-full px-3 py-2 border border-pink-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500">
          <option value="feed">Feed Post</option>
          <option value="story">Story</option>
          <option value="reel">Reel</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-pink-800 mb-2">Tags</label>
        <input type="text" name={"instagram_tags_" + providerName} placeholder="#tag1 #tag2 #tag3" class="w-full px-3 py-2 border border-pink-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" />
        <p class="text-xs text-pink-600 mt-1">Separate tags with spaces</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-pink-800 mb-2">Location</label>
        <input type="text" name={"instagram_location_" + providerName} placeholder="Location name" class="w-full px-3 py-2 border border-pink-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500" />
      </div>
      <div>
        <label class="flex items-center">
          <input type="checkbox" name={"instagram_close_friends_" + providerName} class="h-4 w-4 text-pink-600 focus:ring-pink-500 border-pink-300 rounded" />
          <span class="ml-2 text-sm font-medium text-pink-800">Share with Close Friends only</span>
        </label>
      </div>
    </div>
  </div>
} 