package social

templ LinkedInSettings(providerName string) {
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
    <h3 class="text-lg font-medium text-blue-900 mb-3">LinkedIn Settings for {providerName}</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-blue-800 mb-2">Post Visibility</label>
        <select name={"linkedin_visibility_" + providerName} class="w-full px-3 py-2 border border-blue-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="PUBLIC">Public</option>
          <option value="CONNECTIONS">Connections only</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-blue-800 mb-2">Professional Tags</label>
        <input type="text" name={"linkedin_tags_" + providerName} placeholder="#professional #business #industry" class="w-full px-3 py-2 border border-blue-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        <p class="text-xs text-blue-600 mt-1">Add relevant professional hashtags</p>
      </div>
      <div>
        <label class="flex items-center">
          <input type="checkbox" name={"linkedin_mention_company_" + providerName} class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-blue-300 rounded" />
          <span class="ml-2 text-sm font-medium text-blue-800">Mention company in post</span>
        </label>
      </div>
      <div>
        <label class="flex items-center">
          <input type="checkbox" name={"linkedin_professional_tone_" + providerName} class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-blue-300 rounded" />
          <span class="ml-2 text-sm font-medium text-blue-800">Use professional tone suggestions</span>
        </label>
      </div>
    </div>
  </div>
}