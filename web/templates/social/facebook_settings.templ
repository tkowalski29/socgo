package social

templ FacebookSettings(providerName string) {
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
    <h3 class="text-lg font-medium text-blue-900 mb-3">Facebook Settings for {providerName}</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-blue-800 mb-2">Location</label>
        <input type="text" name={"facebook_location_" + providerName} placeholder="np. Warszawa, Polska" class="w-full px-3 py-2 border border-blue-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        <p class="text-xs text-blue-600 mt-1">Gdzie jesteś lub gdzie zostało zrobione zdjęcie (będzie dodane do treści posta)</p>
      </div>
    </div>
  </div>
} 