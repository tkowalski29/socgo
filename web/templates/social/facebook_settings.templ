package social

templ FacebookSettings(providerName string) {
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
    <h3 class="text-lg font-medium text-blue-900 mb-3">Facebook Settings for {providerName}</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-blue-800 mb-2">Privacy</label>
        <select name={"facebook_privacy_" + providerName} class="w-full px-3 py-2 border border-blue-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="public">Public</option>
          <option value="friends">Friends</option>
          <option value="friends_except">Friends except...</option>
          <option value="specific_friends">Specific friends</option>
          <option value="only_me">Only me</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-blue-800 mb-2">Feeling/Activity</label>
        <input type="text" name={"facebook_feeling_" + providerName} placeholder="Feeling or activity" class="w-full px-3 py-2 border border-blue-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-blue-800 mb-2">Location</label>
        <input type="text" name={"facebook_location_" + providerName} placeholder="Location name" class="w-full px-3 py-2 border border-blue-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
      </div>
      <div>
        <label class="flex items-center">
          <input type="checkbox" name={"facebook_backdated_" + providerName} class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-blue-300 rounded" />
          <span class="ml-2 text-sm font-medium text-blue-800">Backdated post</span>
        </label>
      </div>
    </div>
  </div>
} 