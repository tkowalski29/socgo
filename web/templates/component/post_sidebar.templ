package component

templ PostSidebar() {
  <div id="post-create-sidebar" class="post-create-sidebar">
    <div class="h-full flex flex-col min-h-0">
      <!-- Header -->
      <div class="p-4 border-b border-gray-200 bg-gray-50">
        <div class="container mx-auto flex flex-row justify-between items-center">
          <h3 class="text-lg font-semibold text-gray-900">Utwórz nowy post</h3>
          <!-- Close button -->
          <button 
            id="close-btn"
            onclick="closePostSidebar()"
            class="text-gray-400 hover:text-gray-600 transition-colors"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Content -->
      <div class="flex-1 container mx-auto flex flex-row overflow-hidden min-h-0">
        <!-- Left Side - Content & Media -->
        <div class="w-1/2 border-r border-gray-200 overflow-y-auto">
          <div class="px-4 py-4">
            <form 
              id="post-form"
              hx-post="/posts" 
              hx-encoding="multipart/form-data" 
              hx-target=".container.mx-auto.flex.flex-row.overflow-hidden" 
              hx-swap="innerHTML"
              class="space-y-4"
            >
              <!-- Provider Selection - Above content as small icons -->
              <div>
                <div id="providers-container" class="flex flex-wrap gap-2">
                  <div class="flex items-center justify-center py-2">
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-600"></div>
                    <span class="ml-2 text-xs text-gray-600">Ładowanie...</span>
                  </div>
                </div>
              </div>

              <!-- Text Content -->
              <div>
                <textarea
                  id="content"
                  name="content"
                  rows="6"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none"
                  placeholder="Co chcesz opublikować?"
                  required
                ></textarea>
                <p class="mt-1 text-sm text-gray-500">Maksymalnie 2200 znaków</p>
              </div>

              <!-- Media Upload - Small square -->
              <div class="flex items-start 
              space-x-3">
                <div class="flex-shrink-0">
                  <label for="media" class="w-16 h-16 border-2 border-dashed border-gray-300 rounded-lg hover:border-gray-400 transition-colors flex items-center justify-center cursor-pointer">
                    <input
                      type="file"
                      id="media"
                      name="media"
                      multiple
                      accept="image/*,video/*"
                      class="hidden"
                      onchange="handleFileSelect(this)"
                    />
                    <svg class="h-6 w-6 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                      <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </label>
                </div>
                <div id="file-preview" class="flex-1 flex flex-wrap gap-2"></div>
              </div>
            </form>
          </div>
        </div>

        <!-- Right Side - Provider Settings Tabs -->
        <div class="w-1/2 overflow-y-auto">
          <div class="px-4 py-4">
            <!-- Tabs Section -->
            <div id="tabs-section">
              <!-- Tabs will be generated here -->
              <div id="provider-tabs" class="mb-4 flex items-center space-x-2">
                <!-- Tabs will be loaded here -->
              </div>
              
              <!-- Tab Content -->
              <div id="tab-content" class="space-y-4">
                <!-- Content will be loaded here -->
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer with Submit Button and Date Planning -->
      <div class="p-4 border-t-2 border-gray-300 bg-gray-100">
        <div class="container mx-auto flex flex-row justify-between items-center">
          <div class="flex items-center space-x-4">
            <!-- Date Planning on the left -->
            <div id="date-planning" class="flex items-center space-x-2">
              <span class="text-sm text-gray-600">Data publikacji:</span>
              <div class="relative">
                <input
                  type="text"
                  name="schedule_at_footer"
                  id="schedule_at_footer"
                  readonly
                  class="px-3 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 cursor-pointer"
                  style="direction: ltr; text-align: left; font-family: monospace;"
                />
                <button
                  type="button"
                  id="datetime-picker-btn"
                  class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </button>
                <!-- Hidden native input for form submission -->
                <input
                  type="datetime-local"
                  name="schedule_at_native"
                  id="schedule_at_native"
                  class="hidden"
                />
                
                <!-- Custom datetime picker -->
                <div id="custom-datetime-picker" class="custom-datetime-picker">
                  <div class="datetime-header">
                    <span class="text-sm font-medium">Wybierz datę i godzinę</span>
                    <button type="button" id="close-datetime-picker" class="text-gray-400 hover:text-gray-600">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="datetime-content">
                    <div class="datetime-row">
                      <span class="datetime-label">Data:</span>
                      <input type="date" id="custom-date" class="datetime-input">
                    </div>
                    <div class="datetime-row">
                      <span class="datetime-label">Godzina:</span>
                      <input type="number" id="custom-hour" class="datetime-input" min="0" max="23" placeholder="00">
                      <span>:</span>
                      <input type="number" id="custom-minute" class="datetime-input" min="0" max="59" placeholder="00">
                    </div>
                    <div class="datetime-buttons">
                      <button type="button" id="cancel-datetime" class="datetime-btn">Anuluj</button>
                      <button type="button" id="apply-datetime" class="datetime-btn primary">Zastosuj</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div id="post-result" class="text-sm"></div>
          </div>
          <div class="flex space-x-3">
            <!-- Cancel button -->
            <button
              id="cancel-btn"
              type="button"
              onclick="closePostSidebar()"
              class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              Anuluj
            </button>
            
            <!-- Submit button - Normal state -->
            <button
              id="submit-btn"
              type="button"
              class="px-6 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
              onclick="submitPostForm()"
            >
              <span class="flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
                Opublikuj
              </span>
            </button>
            
            <!-- Submit button - Loading state -->
            <button
              id="submit-btn-loading"
              type="button"
              class="px-6 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed hidden"
              disabled
              onclick="submitPostForm()"
            >
              <span class="flex items-center">
                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                Wysyłanie...
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>




} 