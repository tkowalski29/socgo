package component

import (
	"strings"
)

type FilePreview struct {
	Index    int
	FileName string
	FileType string
	DataURL  string
}

templ FilePreviewContainer(files []FilePreview) {
	<div id="file-preview" class="flex-1 flex flex-wrap gap-2 items-center">
		for _, file := range files {
			<div class="relative group">
				<div class="relative w-16 h-16">
					if strings.HasPrefix(file.FileType, "image/") {
						<img src={ file.DataURL } alt={ file.FileName } class="w-full h-full object-cover rounded-lg">
					} else if strings.HasPrefix(file.FileType, "video/") {
						<video src={ file.DataURL } class="w-full h-full object-cover rounded-lg"></video>
					}
				</div>
			</div>
		}
		if len(files) > 0 {
			<button 
				type="button" 
				onclick="clearAllFiles()"
				title="Wyczyść wszystkie pliki"
				class="text-gray-400 hover:text-red-600 hover:bg-red-50 p-2 rounded-full transition-colors"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		}
	</div>
} 