package component

type ProviderOption struct {
	ID       uint
	Type     string
	Name     string
	IconClass string
	Configured bool
}

templ ProvidersOptions(providers []ProviderOption) {
	if len(providers) == 0 {
		<div class="flex flex-wrap gap-2">
			<p class="text-gray-500">Brak dostępnych platform. <a href="/settings?section=providers" class="text-blue-600 hover:underline">Połącz swoje konta najpierw</a>.</p>
		</div>
	}
	
	<div class="flex flex-wrap gap-2">
		for _, provider := range providers {
			if provider.Configured {
				@ProviderLogo(ProviderLogoProps{
					ID:          provider.ID,
					Type:        provider.Type,
					Name:        provider.Name,
					Size:        "md",
					ShowName:    true,
					Interactive: true,
					Selected:    false,
					Disabled:    false,
				})
			}
		}
	</div>
}

templ ProvidersOptionsError() {
	<div class="flex flex-wrap gap-2">
		<p class="text-red-600 text-sm">Błąd ładowania platform</p>
	</div>
} 