package component

import "github.com/tkowalski/socgo/internal/data/config"

type SettingsProvidersData struct {
	AvailableProviders map[string][]config.ProviderInstance `json:"available_providers"`
}

templ SettingsProvidersContent() {
	<div class="max-w-4xl mx-auto">
		<h1 class="text-4xl font-bold mb-6">Providerzy</h1>
		<p class="mb-8 text-gray-600">Połącz swoje konta w mediach społecznościowych, aby rozpocząć publikowanie treści.</p>
		
		<!-- Connect New Provider Section -->
		<div class="bg-white rounded-lg shadow-md p-6 mb-8">
			<h2 class="text-xl font-semibold mb-4">Połącz nowego providera</h2>
			<div id="providers-grid" hx-get="/api/providers/available" hx-trigger="load" hx-swap="innerHTML">
				<div class="flex items-center justify-center py-8">
					<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
					<span class="ml-2 text-gray-600">Ładowanie dostępnych providerów...</span>
				</div>
			</div>
		</div>
		
		<!-- Connected Providers Section -->
		<div class="bg-white rounded-lg shadow-md p-6">
			<h2 class="text-xl font-semibold mb-4">Połączone konta</h2>
			<div id="providers-list" hx-get="/api/providers" hx-trigger="load, refresh-providers from:body" hx-swap="innerHTML">
				<div class="flex items-center justify-center py-8">
					<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
					<span class="ml-2 text-gray-600">Ładowanie providerów...</span>
				</div>
			</div>
			
			<!-- Success message container -->
			<div id="success-message" class="hidden"></div>
			
			<script>
				// Listen for refresh-providers event and show success message
				document.body.addEventListener('refresh-providers', function() {
					const successMsg = document.getElementById('success-message');
					successMsg.innerHTML = '✓ Provider rozłączony pomyślnie';
					successMsg.className = 'text-center py-4 text-green-600 font-medium';
					successMsg.style.display = 'block';
					
					// Hide success message after 3 seconds
					setTimeout(() => {
						successMsg.style.display = 'none';
					}, 3000);
				});
			</script>
		</div>
	</div>
} 