package templates

type SettingsData struct {
	ActiveSection string
	UserTokens    []UserToken
}

type UserToken struct {
	ID        string
	Name      string
	CreatedAt string
	LastUsed  string
}

templ SettingsContent(data SettingsData) {
	<div class="flex gap-6">
		<!-- Left Sidebar Navigation -->
		<div class="w-64 bg-white rounded-lg shadow-md p-4">
			<h2 class="text-lg font-semibold text-gray-800 mb-4">Ustawienia</h2>
			<nav class="space-y-2">
				<a 
					href="/settings?section=user" 
					class={ "block px-3 py-2 rounded-md text-sm font-medium transition-colors " + settingsNavClass(data.ActiveSection, "user") }
				>
					<div class="flex items-center space-x-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
						</svg>
						<span>Użytkownik</span>
					</div>
				</a>
				<a 
					href="/settings?section=providers" 
					class={ "block px-3 py-2 rounded-md text-sm font-medium transition-colors " + settingsNavClass(data.ActiveSection, "providers") }
				>
					<div class="flex items-center space-x-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						<span>Providerzy</span>
					</div>
				</a>
			</nav>
		</div>

		<!-- Main Content Area -->
		<div class="flex-1">
			if data.ActiveSection == "user" {
				@settingsUserContent(data.UserTokens)
			} else if data.ActiveSection == "providers" {
				@settingsProvidersContent()
			}
		</div>
	</div>
}

templ settingsUserContent(data []UserToken) {
	<div class="w-full max-w-none min-w-0">
		<h1 class="text-4xl font-bold mb-6">Użytkownik</h1>
		<p class="mb-8 text-gray-600">Zarządzaj swoimi tokenami API i ustawieniami użytkownika.</p>
		
		<!-- API Tokens Section -->
		<div class="bg-white rounded-lg shadow-md p-6 mb-8 w-full">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-xl font-semibold">Tokeny API</h2>
				<button 
					onclick="generateNewToken()"
					class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors"
				>
					Generuj nowy token
				</button>
			</div>
			
			if len(data) == 0 {
				<div class="text-center py-8 text-gray-500">
					<svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
					</svg>
					<p>Brak wygenerowanych tokenów API</p>
					<p class="text-sm">Kliknij "Generuj nowy token" aby utworzyć pierwszy token</p>
				</div>
			} else {
				<div class="space-y-3">
					for _, token := range data {
						<div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg border">
							<div>
								<h3 class="font-medium text-gray-900">{ token.Name }</h3>
								<p class="text-sm text-gray-500">Utworzony: { token.CreatedAt }</p>
								if token.LastUsed != "" {
									<p class="text-sm text-gray-500">Ostatnie użycie: { token.LastUsed }</p>
								}
							</div>
							<button 
								data-token-id={ token.ID }
								onclick="deleteToken(this.dataset.tokenId)"
								class="text-red-600 hover:text-red-800 transition-colors"
								title="Usuń token"
							>
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
								</svg>
							</button>
						</div>
					}
				</div>
			}
		</div>
		
		<!-- Success message container -->
		<div id="success-message" class="hidden"></div>
		
		<script>
			// Listen for token operations and show success message
			document.body.addEventListener('token-generated', function() {
				const successMsg = document.getElementById('success-message');
				successMsg.innerHTML = '✓ Token wygenerowany pomyślnie';
				successMsg.className = 'text-center py-4 text-green-600 font-medium';
				successMsg.style.display = 'block';
				
				// Hide success message after 3 seconds
				setTimeout(() => {
					successMsg.style.display = 'none';
				}, 3000);
			});
			
			document.body.addEventListener('token-deleted', function() {
				const successMsg = document.getElementById('success-message');
				successMsg.innerHTML = '✓ Token usunięty pomyślnie';
				successMsg.className = 'text-center py-4 text-green-600 font-medium';
				successMsg.style.display = 'block';
				
				// Hide success message after 3 seconds
				setTimeout(() => {
					successMsg.style.display = 'none';
				}, 3000);
			});
		</script>
	</div>
}

templ settingsProvidersContent() {
	<div class="w-full max-w-none min-w-0">
		<h1 class="text-4xl font-bold mb-6">Providerzy</h1>
		<p class="mb-8 text-gray-600">Połącz swoje konta w mediach społecznościowych, aby rozpocząć publikowanie treści.</p>
		
		<!-- Connect New Provider Section -->
		<div class="bg-white rounded-lg shadow-md p-6 mb-8 w-full">
			<h2 class="text-xl font-semibold mb-4">Połącz nowego providera</h2>
			<div id="providers-grid" hx-get="/api/providers/available" hx-trigger="load" hx-swap="innerHTML">
				<div class="flex items-center justify-center py-8">
					<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
					<span class="ml-2 text-gray-600">Ładowanie dostępnych providerów...</span>
				</div>
			</div>
		</div>
		
		<!-- Connected Providers Section -->
		<div class="bg-white rounded-lg shadow-md p-6 w-full">
			<h2 class="text-xl font-semibold mb-4">Połączone konta</h2>
			<div id="providers-list" hx-get="/api/providers" hx-trigger="load, refresh-providers from:body" hx-swap="innerHTML">
				<div class="flex items-center justify-center py-8">
					<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
					<span class="ml-2 text-gray-600">Ładowanie providerów...</span>
				</div>
			</div>
			
			<!-- Success message container -->
			<div id="success-message" class="hidden"></div>
			
			<script>
				// Listen for refresh-providers event and show success message
				document.body.addEventListener('refresh-providers', function() {
					const successMsg = document.getElementById('success-message');
					successMsg.innerHTML = '✓ Provider rozłączony pomyślnie';
					successMsg.className = 'text-center py-4 text-green-600 font-medium';
					successMsg.style.display = 'block';
					
					// Hide success message after 3 seconds
					setTimeout(() => {
						successMsg.style.display = 'none';
					}, 3000);
				});
			</script>
		</div>
	</div>
}

func settingsNavClass(activeSection, section string) string {
	if activeSection == section {
		return "bg-blue-100 text-blue-700"
	}
	return "text-gray-600 hover:bg-gray-100 hover:text-gray-900"
}

 