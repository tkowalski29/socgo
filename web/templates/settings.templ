package templates

import "github.com/tkowalski/socgo/web/templates/component"

type SettingsData struct {
	ActiveSection string
	UserTokens    []UserToken
}

type UserToken struct {
	ID        string
	Name      string
	CreatedAt string
	LastUsed  string
}

templ SettingsContent(data SettingsData) {
	<div class="flex gap-6">
		<!-- Left Sidebar Navigation -->
		<div class="w-64 bg-white rounded-lg shadow-md p-4">
			<h2 class="text-lg font-semibold text-gray-800 mb-4">Ustawienia</h2>
			<nav class="space-y-2">
				<a 
					href="/settings?section=user" 
					class={ "block px-3 py-2 rounded-md text-sm font-medium transition-colors " + getSettingsNavClass(data.ActiveSection, "user") }
				>
					<div class="flex items-center space-x-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
						</svg>
						<span>Użytkownik</span>
					</div>
				</a>
				<a 
					href="/settings?section=providers" 
					class={ "block px-3 py-2 rounded-md text-sm font-medium transition-colors " + getSettingsNavClass(data.ActiveSection, "providers") }
				>
					<div class="flex items-center space-x-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
						<span>Providerzy</span>
					</div>
				</a>
			</nav>
		</div>

		<!-- Main Content Area -->
		<div class="flex-1">
			if data.ActiveSection == "user" {
				<div class="bg-white rounded-lg shadow-md p-6">
					@UserSection(data.UserTokens)
				</div>
			} else if data.ActiveSection == "providers" {
				@component.SettingsProvidersContent()
			}
		</div>
	</div>
}

templ UserSection(tokens []UserToken) {
	<div>
		<h1 class="text-2xl font-bold text-gray-900 mb-6">Ustawienia użytkownika</h1>
		
		<!-- API Tokens Section -->
		<div class="mb-8">
			<div class="flex justify-between items-center mb-4">
				<h2 class="text-lg font-semibold text-gray-800">Tokeny API</h2>
				<button 
					onclick="generateNewToken()"
					class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors"
				>
					Generuj nowy token
				</button>
			</div>
			
			if len(tokens) == 0 {
				<div class="text-center py-8 text-gray-500">
					<svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
					</svg>
					<p>Brak wygenerowanych tokenów API</p>
					<p class="text-sm">Kliknij "Generuj nowy token" aby utworzyć pierwszy token</p>
				</div>
			} else {
				<div class="bg-gray-50 rounded-lg p-4">
					<div class="space-y-3">
						for _, token := range tokens {
							<div class="flex justify-between items-center p-3 bg-white rounded-md border">
								<div>
									<h3 class="font-medium text-gray-900">{ token.Name }</h3>
									<p class="text-sm text-gray-500">Utworzony: { token.CreatedAt }</p>
									if token.LastUsed != "" {
										<p class="text-sm text-gray-500">Ostatnie użycie: { token.LastUsed }</p>
									}
								</div>
								<button 
									data-token-id={ token.ID }
									onclick="deleteToken(this.dataset.tokenId)"
									class="text-red-600 hover:text-red-800 transition-colors"
									title="Usuń token"
								>
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
								</button>
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}



func getSettingsNavClass(activeSection, section string) string {
	if activeSection == section {
		return "bg-blue-100 text-blue-700"
	}
	return "text-gray-600 hover:bg-gray-100 hover:text-gray-900"
}

 