package templates

import "github.com/tkowalski/socgo/web/templates/component"

type LayoutData struct {
	Title        string
	CurrentPage  string
	FlashMessage string
	FlashType    string
	Content      templ.Component
}

templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en" class="no-js" style="overflow-x: hidden;">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title } - SocGo</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<link rel="stylesheet" href="/static/css/app.css?v=1"/>
			<link rel="stylesheet" href="/static/css/post-sidebar.css?v=1"/>
			<link rel="stylesheet" href="/static/css/calendar.css?v=1"/>

			<noscript>
				<style>
					.js-only { display: none !important; }
					.htmx-indicator { display: none !important; }
				</style>
			</noscript>
		</head>
		<body class="bg-gray-100 min-h-screen" style="overflow-x: hidden;">
			<script>
				// Remove no-js class if JavaScript is enabled
				document.documentElement.classList.remove('no-js');
			</script>
			
			@component.Navbar(data.CurrentPage)
			
			<main class="container mx-auto px-4 py-8">
				if data.FlashMessage != "" {
					<div id="flash-message" class={ "mb-4 p-4 rounded-lg " + getFlashClass(data.FlashType) }>
						{ data.FlashMessage }
					</div>
				}
				
				@data.Content
			</main>
			
			<!-- Global Post Sidebar -->
			@component.PostSidebar()
			
			<!-- Floating Action Button -->
			<button 
				onclick="openPostSidebar()"
				class="fixed bottom-6 right-6 w-14 h-14 bg-blue-600 text-white rounded-full shadow-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 transform hover:scale-110 z-40"
				title="Utwórz nowy post"
			>
				<svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
				</svg>
			</button>
			
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<script src="/static/js/datetime-picker.js?v=2"></script>
			<script src="/static/js/post-sidebar-simple.js?v=20250728"></script>
			<script src="/static/js/calendar.js?v=1"></script>
			<script src="/static/js/settings.js?v=1"></script>
			<script src="/static/js/notifications.js?v=1"></script>
			<script>
				// Auto-hide flash messages after 5 seconds
				const flashMessage = document.getElementById('flash-message');
				if (flashMessage) {
					setTimeout(() => {
						flashMessage.style.transition = 'opacity 0.5s';
						flashMessage.style.opacity = '0';
						setTimeout(() => flashMessage.remove(), 500);
					}, 5000);
				}
			</script>
		</body>
	</html>
}

func getFlashClass(flashType string) string {
	switch flashType {
	case "error":
		return "bg-red-100 text-red-800"
	case "success":
		return "bg-green-100 text-green-800"
	case "warning":
		return "bg-yellow-100 text-yellow-800"
	default:
		return "bg-blue-100 text-blue-800"
	}
} 